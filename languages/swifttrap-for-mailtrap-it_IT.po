msgstr "Il dominio del mittente \"%s\" non è registrato in Mailtrap"

#. translators: %s: the sender email domain
#: includes/swifttrap-site-health.php:103
#, php-format
msgid "The sender email address domain (%s) must be added to your Sending Domains in Mailtrap."
msgstr "Il dominio dell'indirizzo email del mittente (%s) deve essere aggiunto ai tuoi domini di invio in Mailtrap."

#. translators: %s: the sender email domain
