msgstr "SwiftTrap for Mailtrap è configurato correttamente"

#: includes/swifttrap-site-health.php:44
msgid "SwiftTrap for Mailtrap routes your WordPress emails through the Mailtrap Send API."
msgstr "SwiftTrap for Mailtrap instrada le email di WordPress attraverso la Send API di Mailtrap."

#: includes/swifttrap-site-health.php:50
msgid "SwiftTrap for Mailtrap is disabled"
msgstr "SwiftTrap for Mailtrap è disattivato"

#: includes/swifttrap-site-health.php:51
msgid "Mailtrap routing is currently disabled. Emails are sent using the default WordPress mail handler."
msgstr "L'instradamento tramite Mailtrap è attualmente disattivato. Le email vengono inviate con il sistema di invio predefinito di WordPress."

#: includes/swifttrap-site-health.php:57
msgid "Mailtrap API token is missing"
msgstr "Manca il token API di Mailtrap"

#: includes/swifttrap-site-health.php:58
