msgstr "Impossible de vérifier les domaines d'envoi Mailtrap"

#. translators: %s: the error message
#: includes/swifttrap-site-health.php:82
#, php-format
msgid "Connected to Mailtrap, but could not retrieve domains list: %s"
msgstr "Connecté à Mailtrap, mais impossible de récupérer la liste des domaines : %s"

#. translators: %s: the sender email domain
