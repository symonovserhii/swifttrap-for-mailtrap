msgstr "L'acheminement via Mailtrap est actuellement désactivé. Les e-mails sont envoyés via le gestionnaire de messagerie par défaut de WordPress."

#: includes/swifttrap-site-health.php:57
msgid "Mailtrap API token is missing"
msgstr "Le jeton API Mailtrap est manquant"

#: includes/swifttrap-site-health.php:58
